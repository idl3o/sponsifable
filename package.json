{
  "name": "sponsorable",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "Work out what to charge a sponsor, prove the audience, send the pitch, track the pipeline. Local-first, no account, no telemetry.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "npm run build && node scripts/bundle-web.mjs"
  },
  "dependencies": {
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "author": "Sam Lavington (@idl3o)",
  "repository": {
    "type": "git",
    "url": "https://github.com/idl3o/sponsorable.git"
  },
  "keywords": [
    "creator-economy",
    "sponsorship",
    "rate-card",
    "media-kit",
    "pricing",
    "local-first",
    "creators",
    "influencer-marketing"
  ],
  "engines": {
    "node": ">=20"
  }
}
